<component type="desktop-application">
  <id>io.github.Simomagy.RedForge</id>
  <name>RedForge</name>
  <summary>A map editor for RedM</summary>
  <developer id="studio.prysma">
    <name>Prysma Studio</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <description>
    <p>
      RedForge edits Red Dead Redemption 2's maps for RedM: the streamed world, its entities,
      interiors, instanced props and grass, the game's file formats and their XML, projects
      exported as RedM resources, and a bridge to Blender.
    </p>
    <p>It needs an installed copy of Red Dead Redemption 2.</p>
  </description>
