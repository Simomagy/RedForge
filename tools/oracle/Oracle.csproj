<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# RedForge, run headless on Linux as a reference for the Rust port.
       Point RedForgeSource at the C# source tree (default: next to this repo). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>rf-oracle</AssemblyName>
    <RedForgeSource Condition="'$(RedForgeSource)' == ''">$(MSBuildThisFileDirectory)../../../RedForge-Source</RedForgeSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RedForgeSource)/RedForge.Games.RDR2/RedForge.Games.RDR2.csproj" />
  </ItemGroup>
</Project>
